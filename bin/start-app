#!/usr/bin/env bash
set -euo pipefail

if [ -z "${DATA_DIR:-}" ]; then
  echo "ERROR: DATA_DIR is not set. Are you in the dev shell? (nix develop)" >&2
  exit 1
fi

source load-infra-env

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  App:   http://localhost:3000"
echo "  Stack: http://localhost:${PROXY_PORT:-2080} (Caddy → API)"
echo "══════════════════════════════════════════════════════════════"
echo ""

cd app
exec flutter run \
  -d web-server \
  --web-port=3000 \
  --dart-define=DEFAULT_API_BASE_URL="http://localhost:${PROXY_PORT:-2080}"
