#!/usr/bin/env bash
set -euo pipefail

if [ -z "${DATA_DIR:-}" ]; then
  echo "ERROR: DATA_DIR is not set. Are you in the dev shell? (nix develop)" >&2
  exit 1
fi

source load-infra-env

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  Access the full stack at http://localhost:${PROXY_PORT:-2080}"
echo "  (Caddy proxies API calls + serves the Flutter dev server)"
echo "══════════════════════════════════════════════════════════════"
echo ""

cd app
flutter run \
  -d web-server \
  --web-port=3000
