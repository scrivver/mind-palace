#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if command -v docker >/dev/null 2>&1; then
  CTR=docker
elif command -v podman >/dev/null 2>&1; then
  CTR=podman
else
  echo "ERROR: Neither docker nor podman found in PATH" >&2
  exit 1
fi

root_targets=(
  mind-palace-app-container
  mind-palace-ingress-container
)

required_images=(
  mind-palace-app:latest
  mind-palace-ingress:latest
  mind-palace-reliquary-api:latest
  mind-palace-reliquary-thumbnail-worker:latest
  mind-palace-engram-api:latest
  mind-palace-engram-ingestion:latest
  mind-palace-synapse-worker:latest
  mind-palace-synapse-reconciler:latest
)

build_and_load() {
  local owner="$1"
  local flake_ref="$2"
  local target="$3"
  local source_image="$4"
  local platform_image="$5"

  echo "Building $owner#$target..."
  if ! image_path="$(nix build "$flake_ref#$target" --no-link --print-out-paths)"; then
    echo "ERROR: Failed to build $owner image target '$target' from $flake_ref." >&2
    echo "       Check whether the child flake output was renamed or removed." >&2
    exit 1
  fi
  "$CTR" load < "$image_path"

  if [ "$source_image" != "$platform_image" ]; then
    "$CTR" tag "$source_image" "$platform_image"
  fi
}

echo "Using container runtime: $CTR"
echo "=== Building Mind Palace dogfood images ==="

cd "$PROJECT_ROOT"
BUILD_ROOT="$(mktemp -d)"
trap 'rm -rf "$BUILD_ROOT"' EXIT

rsync -a \
  --exclude .git \
  --exclude .data \
  --exclude .dart_tool \
  --exclude build \
  --exclude 'result*' \
  "$PROJECT_ROOT/" "$BUILD_ROOT/"

for target in "${root_targets[@]}"; do
  build_and_load "mind-palace" "path:$BUILD_ROOT" "$target" "${target%-container}:latest" "${target%-container}:latest"
done

if [ -d "$PROJECT_ROOT/reliquary" ]; then
  echo "Building Reliquary component images..."
  build_and_load "reliquary" "path:$BUILD_ROOT/reliquary" api-container \
    reliquary-api:latest mind-palace-reliquary-api:latest
  build_and_load "reliquary" "path:$BUILD_ROOT/reliquary" thumbnail-worker-container \
    reliquary-thumbnail-worker:latest mind-palace-reliquary-thumbnail-worker:latest
else
  echo "ERROR: Missing Reliquary submodule at $PROJECT_ROOT/reliquary" >&2
  exit 1
fi

if [ -d "$PROJECT_ROOT/engram" ]; then
  echo "Building Engram component images..."
  build_and_load "engram" "path:$BUILD_ROOT/engram" api-container \
    engram-api:latest mind-palace-engram-api:latest
  build_and_load "engram" "path:$BUILD_ROOT/engram" ingestion-container \
    engram-ingestion:latest mind-palace-engram-ingestion:latest
else
  echo "ERROR: Missing Engram submodule at $PROJECT_ROOT/engram" >&2
  exit 1
fi

if [ -d "$PROJECT_ROOT/synapse" ]; then
  echo "Building Synapse component images..."
  build_and_load "synapse" "path:$BUILD_ROOT/synapse" worker-container \
    synapse-worker:latest mind-palace-synapse-worker:latest
  build_and_load "synapse" "path:$BUILD_ROOT/synapse" reconciler-container \
    synapse-reconciler:latest mind-palace-synapse-reconciler:latest
else
  echo "ERROR: Missing Synapse submodule at $PROJECT_ROOT/synapse" >&2
  exit 1
fi

echo "Verifying loaded platform image names..."
for image in "${required_images[@]}"; do
  "$CTR" image inspect "$image" >/dev/null
done

echo
echo "=== Ready to deploy ==="
echo "  cp .env.example .env"
echo "  # Edit .env before shared use."
echo "  $CTR compose up -d"
