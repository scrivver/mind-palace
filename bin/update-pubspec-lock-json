#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOCK="$ROOT/app/pubspec.lock"
LOCK_JSON="$ROOT/app/pubspec.lock.json"

if [ ! -f "$LOCK" ]; then
  echo "ERROR: $LOCK does not exist" >&2
  exit 1
fi

if [ "${RELIQUARY_LOCK_JSON_WITH_NIX:-}" != "1" ]; then
  if ! python3 - <<'PY' >/dev/null 2>&1
import yaml
PY
  then
    if ! command -v nix >/dev/null 2>&1; then
      echo "ERROR: python3 cannot import yaml, and nix is not available" >&2
      exit 1
    fi
    exec nix shell --impure \
      --expr 'with import <nixpkgs> {}; python3.withPackages (ps: [ ps.pyyaml ])' \
      -c env RELIQUARY_LOCK_JSON_WITH_NIX=1 "$0" "$@"
  fi
fi

python3 - "$LOCK" "$LOCK_JSON" <<'PY'
import json
import sys
from pathlib import Path

import yaml

lock_path = Path(sys.argv[1])
json_path = Path(sys.argv[2])

data = yaml.safe_load(lock_path.read_text())
json_path.write_text(json.dumps(data, indent=2) + "\n")
print(f"updated {json_path}")
PY
