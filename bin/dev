#!/usr/bin/env bash
set -euo pipefail

if [ -z "${DATA_DIR:-}" ]; then
  echo "ERROR: DATA_DIR is not set. Are you in the dev shell? (nix develop)" >&2
  exit 1
fi

config="${DEV_PROCESS_COMPOSE_FILE:-$DATA_DIR/dev-process-compose.yaml}"
socket="${PC_SOCKET:-$DATA_DIR/process-compose.sock}"

if [ ! -f "$config" ]; then
  echo "ERROR: Full-stack process-compose config not found: $config" >&2
  echo "Enter the dev shell again so Nix can generate it." >&2
  exit 1
fi

export PROJECT_ROOT="${PROJECT_ROOT:-$(pwd)}"

echo "Starting Mind Palace dogfood stack with process-compose"
echo "Config: $config"
echo "Socket: $socket"
exec process-compose up -f "$config" -u "$socket"
