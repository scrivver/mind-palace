# Mind Palace packaged deployment using GHCR images
#
# Copy this file to .env, change the secrets, and run:
#
#   docker compose up -d
#
# The images referenced in docker-compose.yml come from ghcr.io/mind-palace/.
# Replace the registry prefix there if you forked or republished the images.

# Public entry point
MIND_PALACE_PORT=2080
PROXY_BASE_URL=http://localhost:2080
PUBLIC_ORIGIN=http://localhost:2080

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-shared-use
POSTGRES_DB_ENGRAM=engram
POSTGRES_DB_SYNAPSE=synapse

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
ENGRAM_EVENT_QUEUE=engram.ingest
RELIQUARY_THUMBNAIL_QUEUE=reliquary.thumbnail
RELIQUARY_THUMBNAIL_DEAD_QUEUE=reliquary.thumbnail.dead
SYNAPSE_JOBS_QUEUE=synapse.jobs

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-shared-use
RELIQUARY_BUCKET=reliquary
ENGRAM_BUCKET=engram
SYNAPSE_HOT_BUCKET=synapse-hot
SYNAPSE_COLD_BUCKET=synapse-cold

# Shared auth secret for Reliquary-issued JWTs. Engram validates the same token.
JWT_SECRET=change-me-in-shared-use

# Reliquary password auth
RELIQUARY_AUTH_MODE=full
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-in-shared-use

# Optional: Reliquary OIDC mode (set RELIQUARY_AUTH_MODE=oidc and fill these)
# RELIQUARY_OIDC_ISSUER_URL=http://authentik-server:9000/application/o/mind-palace/
# OIDC_CLIENT_ID=mind-palace
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_REDIRECT_URI=http://localhost:2080/callback

# Reliquary events
EVENTS_ENABLED=true
EVENT_QUEUE=engram.ingest
EVENT_DEVICE_NAME=reliquary

# Engram
ENGRAM_PRESIGN_URL_TEMPLATE=http://localhost:2080/api/reliquary/files/{file_path}

# Synapse
S3_HOT_BUCKET=synapse-hot
S3_COLD_BUCKET=synapse-cold
RECONCILE_INTERVAL=30s
