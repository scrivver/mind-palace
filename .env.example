# Mind Palace packaged dogfood deployment

# Public entry point
MIND_PALACE_PORT=2080
PROXY_BASE_URL=http://localhost:2080

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-shared-use
POSTGRES_DB_ENGRAM=engram
POSTGRES_DB_SYNAPSE=synapse
POSTGRES_DB_AUTHENTIK=authentik

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
ENGRAM_EVENT_QUEUE=engram.ingest
RELIQUARY_THUMBNAIL_QUEUE=reliquary.thumbnail
RELIQUARY_THUMBNAIL_DEAD_QUEUE=reliquary.thumbnail.dead
SYNAPSE_JOBS_QUEUE=synapse.jobs

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-shared-use
RELIQUARY_BUCKET=reliquary
ENGRAM_BUCKET=engram
SYNAPSE_HOT_BUCKET=synapse-hot
SYNAPSE_COLD_BUCKET=synapse-cold

# Authentik / OAuth
AUTHENTIK_SECRET_KEY=change-me-in-shared-use
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-in-shared-use
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-in-shared-use
OIDC_CLIENT_ID=mind-palace
OIDC_ISSUER_URL=http://localhost:2080/application/o/mind-palace/

# Reliquary auth and events
AUTH_MODE=full
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-in-shared-use
JWT_SECRET=change-me-in-shared-use
EVENTS_ENABLED=true
EVENT_QUEUE=engram.ingest
EVENT_DEVICE_NAME=reliquary

# Engram
ENGRAM_AUTH_MODE=none
ENGRAM_PRESIGN_URL_TEMPLATE=http://localhost:2080/api/reliquary/files/{file_path}

# Synapse
S3_HOT_BUCKET=synapse-hot
S3_COLD_BUCKET=synapse-cold
RECONCILE_INTERVAL=30s
